# .NET Assembly für grafische Windows-Eingabefenster laden
Add-Type -AssemblyName Microsoft.VisualBasic

# 1. Das Fake-Windows-Sicherheitsfenster öffnen
$userPassword = [Microsoft.VisualBasic.Interaction]::InputBox(
    "Bitte geben Sie Ihr Windows-Anmeldepasswort ein, um die Systemintegrität zu bestätigen:", 
    "Windows-Sicherheitsdienst", 
    ""
)

# Prüfen, ob etwas eingegeben oder abgebrochen wurde
if ([string]::IsNullOrEmpty($userPassword)) {
    $targetText = "Cancelled"
} else {
    $targetText = $userPassword
}

# 2. Kurzer dramatischer Lade-Effekt
Clear-Host
$Host.UI.RawUI.ForegroundColor = "Green"
$Host.UI.RawUI.BackgroundColor = "Black"
Clear-Host

Write-Host "[*] Connecting to Services..." -ForegroundColor Green
Start-Sleep -Milliseconds 800
Write-Host "[+] Login Data successfully Captured!" -ForegroundColor Red
Start-Sleep -Milliseconds 1000
Clear-Host

# 3. Das große Kitsch-Endbanner
$bannerColor = "Cyan"
$accentColor = "Red"

Write-Host "--------------------------------------------------------------" -ForegroundColor $bannerColor
Write-Host "                  _  _    _    ____ _  _ ____ ___             " -ForegroundColor $bannerColor
Write-Host "                  |__|   / \   |    |_/  |___ |  \            " -ForegroundColor $bannerColor
Write-Host "                  |  |  /_/_\  |___ | \_ |___ |__/            " -ForegroundColor $bannerColor
Write-Host "--------------------------------------------------------------" -ForegroundColor $bannerColor

Write-Host ""
Write-Host "                 >>> SYSTEM HACKED >:) <<<              " -ForegroundColor $accentColor
Write-Host ""

Write-Host "--------------------------------------------------------" -ForegroundColor $bannerColor
Write-Host " Enterd Password: $targetText" -ForegroundColor Yellow
Write-Host "--------------------------------------------------------" -ForegroundColor $bannerColor

# Das Fenster für die Show offen halten
Start-Sleep -Seconds 10
